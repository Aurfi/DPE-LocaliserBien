{
  "name": "localisateur-bien-immobilier",
  "version": "1.0.0",
  "description": "Localisateur de bien immobilier - Trouvez l'adresse de n'importe quel bien",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/geography/generate-runtime.mjs --finalize",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:all": "npm run test:run && npm run test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "security:audit": "node scripts/security/audit-policy.mjs",
    "test:security": "node --test scripts/security/*.test.mjs",
    "check:styles": "node scripts/styles/check-classes.mjs",
    "test:styles": "node --test scripts/styles/*.test.mjs",
    "test:html": "node --test scripts/html/*.test.mjs",
    "predev": "npm run check:styles && npm run geography:generate",
    "prebuild": "npm run check:styles && npm run geography:generate && npm run test:geography",
    "geography:generate": "node scripts/geography/generate-runtime.mjs",
    "test:geography": "node --test scripts/geography/*.test.mjs",
    "test:pwa:unit": "node --test scripts/pwa/*.test.mjs",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "test:guides": "playwright test --config=playwright.guides.config.js",
    "test:guides:http": "node scripts/guides/check-http.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.0",
    "@heroicons/vue": "^2.1.0",
    "lucide-vue-next": "^0.400.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "msw": "^2.11.3",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.44.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
